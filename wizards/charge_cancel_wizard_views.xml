<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="pos_hotel_charge_cancel_wizard_form" model="ir.ui.view">
    <field name="name">pos.hotel.charge.cancel.wizard.form</field>
    <field name="model">pos.hotel.charge.cancel.wizard</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="charge_id" invisible="1"/>
          <field name="amount_net"/>
          <field name="reason" placeholder="Ex : erreur de saisie, geste commercial..."/>
        </group>
        <footer>
          <button name="action_confirm" string="Confirmer l'annulation"
                  type="object" class="btn-primary"/>
          <button string="Retour" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>