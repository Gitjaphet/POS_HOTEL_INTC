<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="folio_settle_wizard_form" model="ir.ui.view">
        <field name="name">pos.hotel.folio.settle.wizard.form</field>
        <field name="model">pos.hotel.folio.settle.wizard</field>
        <field name="arch" type="xml">
            <form>
                <field name="sale_order_id" invisible="1"/>
                <field name="currency_id" invisible="1"/>
                <group>
                    <field name="total_due"/>
                    <field name="amount"/>
                    <field name="payment_method_line_id"/>
                </group>
                <footer>
                    <button name="action_confirm_settle" string="Régler" type="object" class="btn-primary"/>
                    <button string="Annuler" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="folio_settle_wizard_action" model="ir.actions.act_window">
        <field name="name">Régler les extras</field>
        <field name="res_model">pos.hotel.folio.settle.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>