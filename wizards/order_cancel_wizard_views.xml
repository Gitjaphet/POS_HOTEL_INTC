<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_hotel_order_cancel_wizard_form" model="ir.ui.view">
        <field name="name">pos.hotel.order.cancel.wizard.form</field>
        <field name="model">pos.hotel.order.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Annuler la commande">
                <group>
                    <field name="sale_order_id" invisible="1"/>
                    <field name="reason" placeholder="Expliquez pourquoi cette commande est annulée..."/>
                </group>
                <footer>
                    <button string="Confirmer l'annulation"
                            name="action_confirm_cancel"
                            type="object"
                            class="btn-primary"/>
                    <button string="Retour"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>