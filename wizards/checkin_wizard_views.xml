<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_hotel_checkin_wizard_form" model="ir.ui.view">
        <field name="name">pos.hotel.checkin.wizard.form</field>
        <field name="model">pos.hotel.checkin.wizard</field>
        <field name="arch" type="xml">
            <form string="Enregistrement / Départ">
                <field name="order_id" invisible="1"/>
                <field name="status" invisible="1"/>
                <field name="line_ids">
                    <list editable="bottom" create="false" delete="false">
                        <field name="selected" widget="boolean_toggle"/>
                        <field name="resource_id" readonly="1"/>
                        <field name="product_id" readonly="1"/>
                        <field name="currency_id" column_invisible="1"/>
                        <field name="x_due_amount" readonly="1" column_invisible="parent.status != 'checkout'"/>
                        <field name="cancel_due_debt" column_invisible="parent.status != 'checkout'"/>
                        <field name="planning_slot_id" column_invisible="1"/>
                    </list>
                </field>
                <field name="reason"
                       placeholder="Motif obligatoire si une dette est annulée au départ"
                       invisible="status != 'checkout'"/>
                <footer>
                    <button string="Valider"
                            name="action_confirm"
                            type="object"
                            class="btn-primary"/>
                    <button string="Retour"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>