<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="pos_hotel_charge_refund_wizard_form" model="ir.ui.view">
    <field name="name">pos.hotel.charge.refund.wizard.form</field>
    <field name="model">pos.hotel.charge.refund.wizard</field>
    <field name="arch" type="xml">
      <form>
        <group>
          <field name="charge_id" invisible="1"/>
          <field name="amount_net"/>
          <field name="payment_method_line_id"/>
        </group>
        <footer>
          <button name="action_confirm" string="Confirmer le remboursement"
                  type="object" class="btn-primary"/>
          <button string="Retour" class="btn-secondary" special="cancel"/>
        </footer>
      </form>
    </field>
  </record>
</odoo>