<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_pos_hotel_add_room_wizard_form" model="ir.ui.view">
        <field name="name">pos.hotel.add.room.wizard.form</field>
        <field name="model">pos.hotel.add.room.wizard</field>
        <field name="arch" type="xml">
            <form string="Ajouter une chambre">
                <group>
                    <field name="sale_order_line_id" invisible="1"/>
                    <field name="available_resource_ids" invisible="1"/>
                    <field name="resource_id"/>
                </group>
                <footer>
                    <button string="Ajouter"
                            name="action_confirm_add_room"
                            type="object"
                            class="btn-primary"/>
                    <button string="Retour"
                            special="cancel"
                            class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>