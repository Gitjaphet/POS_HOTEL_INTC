<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="POS_HOTEL_INTC.HotelStatsTile">
        <div class="o_hotel_tile" t-att-class="tileClass">
            <span class="o_hotel_tile_value" t-esc="tileValue"/>
            <span class="o_hotel_tile_label" t-esc="tileLabel"/>
        </div>
    </t>

    <t t-name="POS_HOTEL_INTC.HotelStats">
        <div t-if="hotelStats.data" class="o_hotel_stats">
            <div class="o_hotel_stats_group">
                <span class="o_hotel_stats_scope">Aujourd'hui</span>
                <div class="o_hotel_tiles">
                    <div class="o_hotel_tile o_hotel_tile_occupied">
                        <span class="o_hotel_tile_value" t-esc="hotelStats.data.occupied"/>
                        <span class="o_hotel_tile_label">Occupées</span>
                    </div>
                    <div class="o_hotel_tile o_hotel_tile_reserved">
                        <span class="o_hotel_tile_value" t-esc="hotelStats.data.reserved"/>
                        <span class="o_hotel_tile_label">Réservées</span>
                    </div>
                    <div class="o_hotel_tile o_hotel_tile_free">
                        <span class="o_hotel_tile_value">
                            <t t-esc="hotelStats.data.free"/><small t-esc="'/' + hotelStats.data.total_rooms"/>
                        </span>
                        <span class="o_hotel_tile_label">Libres</span>
                    </div>
                    <div class="o_hotel_tile o_hotel_tile_soon">
                        <span class="o_hotel_tile_value" t-esc="hotelStats.data.upcoming_departures"/>
                        <span class="o_hotel_tile_label">Départs à venir</span>
                    </div>
                    <div class="o_hotel_tile o_hotel_tile_paid">
                        <span class="o_hotel_tile_value" t-esc="hotelStats.data.paid"/>
                        <span class="o_hotel_tile_label">Payées</span>
                    </div>
                </div>
            </div>

            <div class="o_hotel_stats_group">
                <span class="o_hotel_stats_scope">Période affichée</span>
                <div class="o_hotel_tiles">
                    <div class="o_hotel_tile o_hotel_tile_arrivals">
                        <span class="o_hotel_tile_value" t-esc="hotelStats.data.arrivals"/>
                        <span class="o_hotel_tile_label">Arrivées</span>
                    </div>
                    <div class="o_hotel_tile o_hotel_tile_departures">
                        <span class="o_hotel_tile_value" t-esc="hotelStats.data.departures"/>
                        <span class="o_hotel_tile_label">Départs</span>
                    </div>
                    <div class="o_hotel_tile o_hotel_tile_cancelled">
                        <span class="o_hotel_tile_value" t-esc="hotelStats.data.cancelled"/>
                        <span class="o_hotel_tile_label">Annulées</span>
                    </div>
                </div>
            </div>
        </div>
    </t>

    <t t-inherit="planning.PlanningGanttRenderer" t-inherit-mode="extension">
        <xpath expr="//GanttRendererControls" position="after">
            <t t-call="POS_HOTEL_INTC.HotelStats"/>
        </xpath>
    </t>

</templates>