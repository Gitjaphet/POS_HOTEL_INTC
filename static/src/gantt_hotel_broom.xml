<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <!-- Colonne de l'indicateur de chambre, toujours présente sur les lignes
         de chambre (vide si client en séjour) : les noms restent alignés.
         Insérée comme FRÈRE du span du nom (text-truncate w-0 flex-grow-1),
         jamais dedans : ce span est prévu pour un seul contenu et coupe le
         reste. La clé à molette native est masquée par CSS sur ces lignes
         uniquement (gantt_hotel_broom.scss). -->
    <t t-inherit="planning.PlanningGanttRenderer.RowHeader" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_gantt_row_title')]/span[hasclass('text-truncate')]" position="before">
            <t t-set="hotelBroom" t-value="getHotelBroom(row)"/>
            <span t-if="hotelBroom"
                  t-attf-class="o_hotel_broom o_hotel_broom_{{ hotelBroom }} d-inline-flex flex-shrink-0 align-items-center justify-content-center rounded-circle me-2"
                  t-att-title="getHotelBroomTitle(row)"
                  t-on-click.stop.prevent="() => this.onHotelBroomClick(row)"><t t-if="hotelBroom === 'late'">⏰</t><t t-elif="hotelBroom !== 'none'">🧹</t></span>
        </xpath>
    </t>
</templates>
