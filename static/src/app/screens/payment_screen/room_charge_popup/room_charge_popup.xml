<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="pos_hotel_intc.RoomChargePopup">
    <Dialog title="'Transfert Chambre'" size="'md'">
      <div class="room-charge-popup">
        <input
          type="text"
          class="form-control mb-3"
          placeholder="Rechercher un nom, une chambre ou une agence..."
          t-model="state.search"
          autofocus="autofocus"
        />
        <div class="list-group">
          <t t-foreach="rows" t-as="row" t-key="row.key">
            <button
              class="list-group-item list-group-item-action d-flex justify-content-between align-items-center"
              t-att-class="{'list-group-item-info': row.isAgency}"
              t-on-click="() => this.selectRow(row)"
            >
              <span t-if="row.isAgency">
                <strong t-esc="row.partnerName"/>
                <span class="text-muted"> — pension du groupe <t t-esc="row.orderName"/></span>
              </span>
              <span t-else="">
                <strong t-esc="row.partnerName"/>
                <span class="text-muted"> — Chambre <t t-esc="row.roomName"/></span>
                <span t-if="row.agencyName" class="text-muted small"> (<t t-esc="row.agencyName"/>)</span>
              </span>
              <span t-if="dueOf(row)" class="badge bg-warning text-dark">
                Dû: <t t-esc="dueOf(row)"/>
              </span>
            </button>
          </t>
          <div t-if="!rows.length" class="text-muted text-center py-3">
            Aucun client en chambre trouvé.
          </div>
        </div>
      </div>
    </Dialog>
  </t>
</templates>
