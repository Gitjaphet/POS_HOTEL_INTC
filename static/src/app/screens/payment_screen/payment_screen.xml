<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('partner-button')]" position="before">
            <button class="button room-button btn btn-secondary btn-lg w-100 w-md-50 lh-lg text-truncate"
                t-on-click="() => this.openRoomChargePopup()">
                <i class="fa fa-bed me-2" role="img" title="Chambre" />
                <span>Chambre</span>
            </button>
        </xpath>
    </t>
</templates>