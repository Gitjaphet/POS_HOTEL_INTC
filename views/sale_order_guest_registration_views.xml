<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fenêtre « Enregistrement des occupants », ouverte par Arrivée. -->
    <record id="sale_order_view_form_guest_registration" model="ir.ui.view">
        <field name="name">sale.order.form.guest.registration</field>
        <field name="model">sale.order</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Enregistrement des occupants">
                <div class="alert alert-warning mb-3" role="alert"
                     invisible="not x_guest_registration_issues">
                    <field name="x_guest_registration_issues" nolabel="1" readonly="1"/>
                </div>
                <field name="x_stay_guest_ids" nolabel="1">
                    <list editable="bottom">
                        <field name="sale_order_line_id" string="Chambre"
                               context="{'hotel_room_label': True}"
                               options="{'no_create': True, 'no_open': True}"
                               domain="[('order_id', '=', parent.id), ('x_is_a_room_offer', '=', True)]"/>
                        <field name="partner_id"/>
                        <field name="is_main"/>
                        <field name="is_child"/>
                        <field name="nationality_id" options="{'no_create': True}"/>
                        <field name="document_type"/>
                        <field name="document_number"/>
                        <field name="document_expiry" optional="hide"/>
                        <field name="birth_date" optional="show"/>
                        <field name="birth_place" optional="hide"/>
                    </list>
                </field>
                <footer>
                    <button name="action_x_confirm_guest_registration" type="object"
                            string="Valider l'arrivée" class="btn-primary"/>
                    <button special="cancel" string="Annuler"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
