<odoo>
    <record id="planning_gantt_view_hotel_color" model="ir.ui.view">
        <field name="name">planning.slot.gantt.hotel.color</field>
        <field name="model">planning.slot</field>
        <field name="inherit_id" ref="booking_engine.booking_engine_planning_gantt_view"/>
        <field name="arch" type="xml">
            <xpath expr="//gantt" position="attributes">
                <attribute name="color">color</attribute>
            </xpath>

            <!-- Champs chargés pour chaque barre : statut (couleur), paiement
                 (icône), source (étiquette). sale_line_id distingue une vraie
                 réservation d'un devis (barre grise). -->
            <xpath expr="//gantt" position="inside">
                <field name="x_stay_status"/>
                <field name="x_payment_state"/>
                <field name="sale_line_id"/>
                <field name="x_booking_source_id"/>
                <field name="x_booking_source_code"/>
                <field name="x_booking_source_color"/>
            </xpath>
        </field>
    </record>
</odoo>
