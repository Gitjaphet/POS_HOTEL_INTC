<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_sale_advance_payment_inv_pos_hotel_intc" model="ir.ui.view">
    <field name="name">sale.advance.payment.inv.form.pos.hotel.intc</field>
    <field name="model">sale.advance.payment.inv</field>
    <field name="inherit_id" ref="sale.view_sale_advance_payment_inv"/>
    <field name="arch" type="xml">
      <group name="down_payment_specification" position="before">
        <field name="x_has_due_pos_extras" invisible="1"/>
        <field name="x_currency_id" invisible="1"/>
        <group invisible="advance_payment_method != 'delivered' or not x_has_due_pos_extras">
          <!-- Une case par type, chacune visible seulement s'il y a quelque
               chose à facturer de ce type, avec le montant dû. -->
          <label for="x_include_pos_extras" invisible="not x_due_extras_amount"/>
          <div class="o_row" invisible="not x_due_extras_amount">
            <field name="x_include_pos_extras"/>
            <field name="x_due_extras_amount" readonly="1" class="text-muted"/>
          </div>
          <label for="x_include_services" invisible="not x_due_services_amount"/>
          <div class="o_row" invisible="not x_due_services_amount">
            <field name="x_include_services"/>
            <field name="x_due_services_amount" readonly="1" class="text-muted"/>
          </div>
          <field name="x_invoice_layout" widget="radio"
                 invisible="not x_include_pos_extras"/>
        </group>
      </group>
    </field>
  </record>
</odoo>
