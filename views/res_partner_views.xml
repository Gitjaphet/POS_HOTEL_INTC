<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Fiche contact : identité complète sous les champs de booking_engine. -->
    <record id="res_partner_form_view_pos_hotel_intc" model="ir.ui.view">
        <field name="name">res.partner.form.pos_hotel_intc.identity</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="booking_engine.res_partner_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='x_document_number']" position="after">
                <field name="x_document_expiry" invisible="is_company"/>
                <field name="x_birth_date" invisible="is_company"/>
                <field name="x_birth_place" invisible="is_company"/>
            </xpath>
        </field>
    </record>
</odoo>
