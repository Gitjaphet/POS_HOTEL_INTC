<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Colonne « Chambre » unique (widget hotel_room_picker) : texte des
         chambres sur une ligne existante, menu des chambres libres sur une
         nouvelle ligne (affichées « 301 (Chambre Studio) »), obligatoire sur
         une réservation confirmée. L'ancienne colonne texte reste chargée
         (invisible) : le widget s'en sert. Les nouvelles lignes reçoivent les
         dates du séjour : dates et nuits visibles dès l'ajout. -->
    <record id="sale_order_room_picker_view" model="ir.ui.view">
        <field name="name">sale.order.form.hotel.room.picker</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="POS_HOTEL_INTC.sale_order_primary_view_pos_hotel_intc"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']" position="attributes">
                <attribute name="context">{'default_x_room_start_date': rental_start_date, 'default_x_room_return_date': rental_return_date, 'default_is_rental': True}</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='x_room_resource_names']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='order_line']//list//field[@name='x_room_resource_names']" position="after">
                <field name="x_available_room_ids" column_invisible="1"/>
                <field name="x_requested_room_id"
                       string="Chambre"
                       widget="hotel_room_picker"
                       width="190px"
                       placeholder="Choisir une chambre…"
                       context="{'hotel_show_room_type': True}"
                       options="{'no_create': True, 'no_open': True}"
                       invisible="display_type"
                       required="not x_room_resource_names and not display_type and parent.state == 'sale'"
                       readonly="x_room_resource_names or parent.state == 'cancel' or parent.locked"/>
            </xpath>
        </field>
    </record>
</odoo>
