<odoo>
    <!-- Sous chaque paiement de la facture : le mode de paiement (journal),
         ou « Réglé pendant le séjour » pour les consommations déjà réglées
         incluses dans une facture finale complète (account_move_prepaid). -->
    <template id="report_invoice_document_payment_method" inherit_id="account.report_invoice_document">
        <xpath expr="//i[hasclass('oe_payment_label')]" position="inside">
            <span t-if="payment_vals.get('name') == 'Réglé pendant le séjour'"> (Réglé pendant le séjour)</span>
            <span t-elif="payment_vals.get('journal_name')"> (<t t-out="payment_vals['journal_name']"/>)</span>
        </xpath>
    </template>
</odoo>
