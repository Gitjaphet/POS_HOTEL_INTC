<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="sale_order_primary_view_pos_hotel_intc" model="ir.ui.view">
    <field name="name">sale.order.form.primary.pos.hotel.intc</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="mode">primary</field>
    <field name="priority">999</field>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Extra Charge" name="x_extra_charge">
          <field name="x_folio_charge_normal_ids" nolabel="1">
            <list create="0" delete="0" default_group_by="payment_status">
              <field name="date"/>
              <field name="name"/>
              <field name="occupant_display"/>
              <field name="pos_config_id" string="Point de Vente"/>
              <field name="amount_net" string="Montant" sum="Total"/>
              <field name="refund_status" widget="badge"
                     decoration-success="refund_status == 'none'"
                     decoration-warning="refund_status == 'partial'"
                     decoration-danger="refund_status == 'full'"/>
              <field name="payment_status" widget="badge"
                     decoration-success="payment_status == 'paid_pos'"
                     decoration-warning="payment_status == 'due'"
                     decoration-info="payment_status == 'settled'"/>
            </list>
          </field>
          <div class="oe_right" style="text-align: right; margin-top: 8px;">
            <button name="%(folio_settle_wizard_action)d"
                    string="Régler les extras"
                    type="action"
                    class="btn-primary"
                    context="{'default_sale_order_id': id}"
                    invisible="x_folio_total_due &lt;= 0"/>
          </div>
          <div class="oe_right" style="text-align: right; margin-top: 8px;">
            <strong>Total Extra Payé : </strong>
            <field name="x_folio_total_paid" nolabel="1" class="oe_inline"/>
            <span style="margin: 0 16px;"/>
            <strong>Total Extra Dû : </strong>
            <field name="x_folio_total_due" nolabel="1" class="oe_inline"/>
          </div>
          <separator string="Historique des remboursements"/>
          <field name="x_folio_charge_refund_ids" nolabel="1">
            <list create="0" delete="0">
              <field name="date"/>
              <field name="name"/>
              <field name="original_charge_id" string="Charge d'origine"/>
              <field name="amount" sum="Total"/>
              <field name="payment_status" widget="badge"
                     decoration-success="payment_status == 'paid_pos'"
                     decoration-warning="payment_status == 'due'"
                     decoration-info="payment_status == 'settled'"/>
            </list>
          </field>
        </page>
        <page string="Historique des chambres" name="x_room_removal_history">
          <field name="x_room_removal_log_ids" nolabel="1">
            <list create="0" delete="0" edit="0">
              <field name="date"/>
              <field name="resource_name" string="Chambre"/>
              <field name="reason" string="Motif"/>
              <field name="cancel_due_debt" string="Dette annulée"/>
              <field name="due_amount_at_removal" string="Montant dû à l'époque"/>
              <field name="user_id" string="Retiré par"/>
            </list>
          </field>
        </page>
        <page string="Occupation" name="x_room_occupation">
          <field name="x_room_stay_slot_ids" nolabel="1">
            <list create="0" delete="0" edit="0" default_group_by="x_stay_status">
              <field name="resource_id" string="Chambre"/>
              <field name="start_datetime" string="Début séjour"/>
              <field name="end_datetime" string="Fin séjour"/>
              <field name="x_stay_status" string="Statut" widget="badge"
                     decoration-muted="x_stay_status == 'pending'"
                     decoration-success="x_stay_status == 'checked_in'"
                     decoration-info="x_stay_status == 'checked_out'"/>
              <field name="x_checked_in_at" string="Enregistré le"/>
              <field name="x_checked_out_at" string="Parti le"/>
            </list>
          </field>
        </page>
      </xpath>

      <xpath expr="//field[@name='rental_start_date']" position="after">
        <field name="x_folio_period_start"
               string="Début Folio (multi-chambres)"
               readonly="1"
               invisible="not x_folio_is_multi_room"/>
        <field name="x_folio_period_end"
               string="Fin Folio (multi-chambres)"
               readonly="1"
               invisible="not x_folio_is_multi_room"/>
      </xpath>

      <button name="action_cancel" position="attributes">
        <attribute name="invisible">1</attribute>
      </button>
      <button name="action_cancel" position="after">
        <button string="Annuler"
                name="action_open_cancel_wizard"
                type="object"
                invisible="state not in ['draft', 'sent', 'sale'] or not id or locked"/>
      </button>

      <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="after">
        <field name="x_is_a_room_offer" column_invisible="1"/>
        <field name="x_room_start_date"
               string="Début séjour"
               invisible="not x_is_a_room_offer"
               readonly="parent.state == 'cancel' or parent.locked"/>
        <field name="x_room_return_date"
               string="Fin séjour"
               invisible="not x_is_a_room_offer"
               readonly="parent.state == 'cancel' or parent.locked"/>
      </xpath>

      <xpath expr="//field[@name='order_line']//list//field[@name='product_id']" position="after">
        <field name="x_room_resource_names" string="Chambre" invisible="not x_is_a_room_offer"/>
      </xpath>
      <xpath expr="//field[@name='order_line']//list//field[@name='price_unit']" position="before">
        <field name="x_room_price_per_night" string="Prix/nuit" invisible="not x_is_a_room_offer"/>
      </xpath>
      <xpath expr="//field[@name='order_line']//list//field[@name='x_room_return_date']" position="after">
        <field name="x_room_nights" string="Nuits" invisible="not x_is_a_room_offer"/>
      </xpath>
      <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_qty']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='order_line']//list//field[@name='qty_delivered']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='order_line']//list//field[@name='qty_returned']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>
      <xpath expr="//field[@name='order_line']//list//field[@name='product_uom_id']" position="attributes">
        <attribute name="column_invisible">1</attribute>
      </xpath>

      <xpath expr="//field[@name='order_line']//list//field[@name='x_room_resource_names']" position="after">
        <button name="action_open_add_room_wizard"
                type="object"
                icon="fa-plus-circle"
                title="Ajouter une chambre"
                invisible="not x_is_a_room_offer or parent.state != 'sale' or parent.locked"/>
        <button name="action_open_remove_room_wizard"
                type="object"
                icon="fa-minus-circle"
                title="Retirer une chambre"
                invisible="not x_is_a_room_offer or parent.state != 'sale' or parent.locked"/>
      </xpath>

      <xpath expr="//field[@name='order_line']" position="attributes">
        <attribute name="domain">['|', ('x_is_a_room_offer', '=', False), ('product_uom_qty', '&gt;', 0)]</attribute>
      </xpath>

      <xpath expr="//field[@name='order_line']//list" position="attributes">
        <attribute name="decoration-muted">x_is_a_room_offer and product_uom_qty == 0</attribute>
      </xpath>

      <xpath expr="//button[@name='action_open_return'][@class='btn-primary']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//button[@name='action_open_return'][@class='btn-secondary']" position="attributes">
        <attribute name="invisible">1</attribute>
      </xpath>
      <xpath expr="//button[@name='action_open_return'][@class='btn-secondary']" position="after">
        <button string="Départ"
                name="action_open_return"
                type="object"
                class="btn-primary"
                invisible="state != 'sale' or not has_returnable_lines"/>
      </xpath>

      <xpath expr="//button[@name='action_open_pickup']" position="attributes">
        <attribute name="string">Arrivée</attribute>
      </xpath>

      <xpath expr="//div[@invisible=&quot;not has_rented_products or state != 'sale' or rental_status != 'pickup' or not is_late&quot;]" position="replace">
        <div class="badge rounded-pill text-bg-danger float-end border-0"
             invisible="not has_rented_products or state != 'sale' or rental_status != 'pickup' or not is_late">Arrivée tardive</div>
      </xpath>

      <xpath expr="//div[@invisible=&quot;not has_rented_products or state != 'sale' or rental_status != 'return' or is_late&quot;]" position="replace">
        <div class="badge rounded-pill text-bg-warning float-end border-0"
             invisible="not has_rented_products or state != 'sale' or rental_status != 'return' or is_late">Arrivé</div>
      </xpath>
    </field>
  </record>
</odoo>