<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="sale_order_view_inherit_pos_hotel_intc" model="ir.ui.view">
    <field name="name">sale.order.form.inherit.pos.hotel.intc</field>
    <field name="model">sale.order</field>
    <field name="inherit_id" ref="sale.view_order_form"/>
    <field name="mode">extension</field>
    <field name="priority">170</field>
    <field name="arch" type="xml">
      <xpath expr="//notebook" position="inside">
        <page string="Extra Charge" name="x_extra_charge">
          <field name="x_folio_charge_ids" nolabel="1">
            <list create="0" delete="0">
              <field name="date"/>
              <field name="name"/>
              <field name="partner_id"/>
              <field name="pos_config_id" string="Point de Vente"/>
              <field name="amount" sum="Total"/>
              <field name="payment_status" widget="badge"
                     decoration-success="payment_status == 'paid_pos'"
                     decoration-warning="payment_status == 'due'"
                     decoration-info="payment_status == 'settled'"/>
            </list>
          </field>
        </page>
      </xpath>
    </field>
  </record>
</odoo>